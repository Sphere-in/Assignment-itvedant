{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowApprovedUsersToListBucket",
            "Effect": "Allow",
            "Principal": {
                "AWS": [
                    "arn:aws:iam::667528811503:user/Raihan",
                    "arn:aws:iam::667528811503:user/s3-user"
                ]
            },
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::lx-dev-data"
        },
        {
            "Sid": "AllowApprovedUsersObjectAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": [
                    "arn:aws:iam::667528811503:user/Raihan",
                    "arn:aws:iam::667528811503:user/s3-user"
                ]
            },
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion",
                "s3:AbortMultipartUpload",
                "s3:ListMultipartUploadParts"
            ],
            "Resource": "arn:aws:s3:::lx-dev-data/*"
        },
        {
            "Sid": "AllowVPCApplicationsToReadObjects",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::lx-dev-data/*",
            "Condition": {
                "StringEquals": {
                    "aws:SourceVpc": "vpc-0f1e27305e6e935ff"
                }
            }
        },
        {
            "Sid": "AllowReplicationRoleToReadSource",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::713554441658:role/S3CrossAccountReplicationRole"
            },
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::lx-dev-data"
        },
        {
            "Sid": "AllowReplicationRoleToReadObjectVersions",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::713554441658:role/S3CrossAccountReplicationRole"
            },
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:GetObjectVersionForReplication",
                "s3:GetObjectVersionAcl",
                "s3:GetObjectVersionTagging"
            ],
            "Resource": "arn:aws:s3:::lx-dev-data/*"
        },
        {
            "Sid": "DenyWritesFromOtherVPCPrincipals",
            "Effect": "Deny",
            "Principal": "*",
            "NotAction": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::lx-dev-data",
                "arn:aws:s3:::lx-dev-data/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:SourceVpc": "vpc-0f1e27305e6e935ff"
                },
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:aws:iam::667528811503:user/Raihan",
                        "arn:aws:iam::667528811503:user/s3-user",
                        "arn:aws:iam::713554441658:role/S3CrossAccountReplicationRole"
                    ]
                }
            }
        },
        {
            "Sid": "DenyUnapprovedPrincipalsOutsideVPC",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::lx-dev-data",
                "arn:aws:s3:::lx-dev-data/*"
            ],
            "Condition": {
                "StringNotEquals": {
                    "aws:SourceVpc": "vpc-0f1e27305e6e935ff"
                },
                "ArnNotEquals": {
                    "aws:SourceArn": "arn:aws:cloudfront::667528811503:distribution/E1UT5TO0M5A4P1"
                },
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:aws:iam::667528811503:user/Raihan",
                        "arn:aws:iam::667528811503:user/s3-user",
                        "arn:aws:iam::713554441658:role/S3CrossAccountReplicationRole"
                    ]
                }
            }
        },
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::lx-dev-data",
                "arn:aws:s3:::lx-dev-data/*"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        },
        {
            "Sid": "AllowCloudFrontServicePrincipal",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudfront.amazonaws.com"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::lx-dev-data/*",
            "Condition": {
                "StringEquals": {
                    "AWS:SourceArn": "arn:aws:cloudfront::667528811503:distribution/E1UT5TO0M5A4P1"
                }
            }
        }
    ]
}